# ─── Friday configuration ────────────────────────────────────────────────────
# Copy to .env and fill in. Everything has a safe default except the AI keys.

# HTTP port for the API server (the web app is served by Vite in dev, and by
# the API server itself after `npm run build`).
PORT=8787

# Database file path (SQLite). ":memory:" is allowed for tests.
DATABASE_PATH=./data/friday.db

# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── AI (optional but recommended) ──────────────────────────────────────────
# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, Groq, local
# Ollama/vLLM, etc.). Without keys the app still works using a built-in
# deterministic natural-language engine for Hinglish/English task capture,
# but transcription and interpretation quality is much better with a model.
OPENAI_API_KEY=
# Optional: override the API base URL (e.g. https://api.groq.com/openai/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
# Chat model used for natural-language interpretation.
OPENAI_MODEL=gpt-4o-mini
# Whisper model used for voice transcription.
WHISPER_MODEL=whisper-1

# ─── Voice ──────────────────────────────────────────────────────────────────
# "auto": browser speech-to-text first (Web Speech API, en-IN/hi-IN), falling
# back to server transcription for unsupported browsers. Set "server" to
# always transcribe recorded audio with Whisper (requires OPENAI_API_KEY).
VOICE_PROVIDER=auto

# ─── Notifications / Web Push (optional) ────────────────────────────────────
# Generate a VAPID key pair with:
#   node -e "const c=require('crypto');const {publicKey,privateKey}=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log('VAPID_PUBLIC_KEY='+publicKey.export({type:'spki',format:'der'}).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+privateKey.export({type:'pkcs8',format:'der'}).toString('base64url'))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact shown to the push service (mailto: or https URL).
VAPID_SUBJECT=mailto:you@example.com

# ─── Misc ───────────────────────────────────────────────────────────────────
# Default timezone used for all date interpretation and scheduling.
APP_TIMEZONE=Asia/Kolkata
# Log level: debug | info | warn | error
LOG_LEVEL=info
